rules_version = '2';

// Starhop security rules.
// Paste this into Firebase console -> Firestore Database -> Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isBanned(uid) { return exists(/databases/$(database)/documents/banned/$(uid)); }

    // Seconds since this pilot's current run started (stamped by the server).
    function runSeconds(uid) {
      return (request.time.toMillis()
        - get(/databases/$(database)/documents/runs/$(uid)).data.startedAt.toMillis()) / 1000;
    }
    // A new best must be possible in the time the run has lasted:
    // at most 2 points per second plus 5, and the run must be under 30 minutes old.
    // (The best real play measured is about 1.4 points per second.)
    function plausibleBest(uid) {
      let newBest = request.resource.data.best;
      let oldBest = resource == null ? 0 : resource.data.best;
      return newBest <= oldBest
        || (exists(/databases/$(database)/documents/runs/$(uid))
            && runSeconds(uid) <= 1800
            && newBest <= runSeconds(uid) * 2 + 5);
    }

    // Each pilot's private save: only that pilot can read or change it.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.callsign is string
        && request.resource.data.callsign.size() >= 3
        && request.resource.data.callsign.size() <= 16
        && request.resource.data.size() < 40;
    }

    // When a logged-in run starts, the server stamps the time.
    match /runs/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['startedAt'])
        && request.resource.data.startedAt == request.time;
    }

    // Callsigns are unique: the first pilot to claim one owns it.
    match /callsigns/{name} {
      allow read: if true;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_-]{3,16}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Public leaderboard: anyone can read; each pilot writes only their own row,
    // under a callsign they own, with a score that fits the run's real duration.
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && !isBanned(uid)
        && request.resource.data.keys().hasOnly(['callsign', 'best', 'updatedAt'])
        && request.resource.data.best is int
        && request.resource.data.best >= 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.callsign is string
        && get(/databases/$(database)/documents/callsigns/$(request.resource.data.callsign.lower())).data.uid == request.auth.uid
        && plausibleBest(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Public pilot profiles: anyone can read; each pilot writes only their own,
    // under a callsign they own. (Shown numbers are self-reported, except the
    // leaderboard best, which comes from the verified leaderboard row.)
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && !isBanned(uid)
        && request.resource.data.keys().hasOnly(['callsign', 'flights', 'missions', 'mStars', 'badges',
                                                  'ship', 'trail', 'theme', 'since', 'updatedAt'])
        && request.resource.data.callsign is string
        && get(/databases/$(database)/documents/callsigns/$(request.resource.data.callsign.lower())).data.uid == request.auth.uid
        && request.resource.data.flights is int && request.resource.data.flights >= 0
        && request.resource.data.missions is int && request.resource.data.missions <= 100
        && request.resource.data.mStars is int && request.resource.data.mStars <= 300
        && request.resource.data.badges is list && request.resource.data.badges.size() <= 100
        && request.resource.data.ship is string && request.resource.data.ship.size() <= 20
        && request.resource.data.trail is string && request.resource.data.trail.size() <= 20
        && request.resource.data.theme is string && request.resource.data.theme.size() <= 20
        && request.resource.data.since is string && request.resource.data.since.size() <= 10
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Friend requests: friendReqs/{to}_{from}. Only the two pilots involved can see
    // or remove one (accept, decline, cancel); only the sender can create it.
    match /friendReqs/{id} {
      allow read, delete: if signedIn()
        && (request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
      allow create: if signedIn()
        && !isBanned(request.auth.uid)
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'toName', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.resource.data.to + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/leaderboard/$(request.resource.data.to))
        && request.resource.data.fromName is string
        && get(/databases/$(database)/documents/callsigns/$(request.resource.data.fromName.lower())).data.uid == request.auth.uid
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 16
        && request.resource.data.at == request.time;
    }

    // Friendships: friendships/{a}_{b} with the two user IDs in sorted order.
    // Created only by the pilot accepting a pending request; either friend can remove it.
    match /friendships/{id} {
      allow read, delete: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'at'])
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && id == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.auth.uid in request.resource.data.users
        && exists(/databases/$(database)/documents/friendReqs/$(request.auth.uid + '_' + (request.resource.data.users[0] == request.auth.uid ? request.resource.data.users[1] : request.resource.data.users[0])))
        && request.resource.data.at == request.time;
    }

    // Admins are added by hand in the Firebase console (a document named after their user ID).
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Banned pilots can't post to the leaderboard. Only admins can ban or unban.
    match /banned/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isAdmin();
    }

    // Anonymous daily play counters (no personal data). Anyone can add exactly 1
    // to one known counter at a time; only admins can read them.
    function statKeys() {
      return ['users', 'newUsers', 'returningUsers', 'd1Returns', 'runs', 'firstRuns',
              'tutorialStarts', 'tutorialDone', 'signups', 'missionStarts', 'missionClears'];
    }
    // A counter either stays the same or goes up by exactly 1.
    function sameOrPlusOne(k) {
      return request.resource.data.get(k, 0) == resource.data.get(k, 0)
          || request.resource.data.get(k, 0) == resource.data.get(k, 0) + 1;
    }
    match /stats/{day} {
      allow read: if isAdmin();
      allow create: if day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && request.resource.data.size() == 1
        && request.resource.data.keys().hasOnly(statKeys())
        && request.resource.data[request.resource.data.keys()[0]] == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(statKeys())
        && sameOrPlusOne('users') && sameOrPlusOne('newUsers') && sameOrPlusOne('returningUsers') && sameOrPlusOne('d1Returns')
        && sameOrPlusOne('runs') && sameOrPlusOne('firstRuns') && sameOrPlusOne('tutorialStarts') && sameOrPlusOne('tutorialDone')
        && sameOrPlusOne('signups') && sameOrPlusOne('missionStarts') && sameOrPlusOne('missionClears');
      allow delete: if false;
    }
  }
}
