rules_version = '2';

// Starhop security rules.
// Paste this into Firebase console -> Firestore Database -> Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isBanned(uid) { return exists(/databases/$(database)/documents/banned/$(uid)); }

    // Seconds since this pilot's current run started (stamped by the server).
    function runSeconds(uid) {
      return (request.time.toMillis()
        - get(/databases/$(database)/documents/runs/$(uid)).data.startedAt.toMillis()) / 1000;
    }
    // A new best must be possible in the time the run has lasted:
    // at most 2 points per second plus 5, and the run must be under 30 minutes old.
    // (The best real play measured is about 1.4 points per second.)
    function plausibleBest(uid) {
      let newBest = request.resource.data.best;
      let oldBest = resource == null ? 0 : resource.data.best;
      return newBest <= oldBest
        || (exists(/databases/$(database)/documents/runs/$(uid))
            && runSeconds(uid) <= 1800
            && newBest <= runSeconds(uid) * 2 + 5);
    }

    // Each pilot's private save: only that pilot can read or change it.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.callsign is string
        && request.resource.data.callsign.size() >= 3
        && request.resource.data.callsign.size() <= 16
        && request.resource.data.size() < 40;
    }

    // When a logged-in run starts, the server stamps the time.
    match /runs/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['startedAt'])
        && request.resource.data.startedAt == request.time;
    }

    // Callsigns are unique: the first pilot to claim one owns it.
    match /callsigns/{name} {
      allow read: if true;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_-]{3,16}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Public leaderboard: anyone can read; each pilot writes only their own row,
    // under a callsign they own, with a score that fits the run's real duration.
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && !isBanned(uid)
        && request.resource.data.keys().hasOnly(['callsign', 'best', 'updatedAt'])
        && request.resource.data.best is int
        && request.resource.data.best >= 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.callsign is string
        && get(/databases/$(database)/documents/callsigns/$(request.resource.data.callsign.lower())).data.uid == request.auth.uid
        && plausibleBest(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Public pilot profiles: anyone can read; each pilot writes only their own,
    // under a callsign they own. (Shown numbers are self-reported, except the
    // leaderboard best, which comes from the verified leaderboard row.)
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && !isBanned(uid)
        && request.resource.data.keys().hasOnly(['callsign', 'flights', 'missions', 'mStars', 'badges',
                                                  'ship', 'trail', 'theme', 'since', 'show', 'updatedAt'])
        && (!('show' in request.resource.data)
            || (request.resource.data.show is list && request.resource.data.show.size() <= 2))
        && request.resource.data.callsign is string
        && get(/databases/$(database)/documents/callsigns/$(request.resource.data.callsign.lower())).data.uid == request.auth.uid
        && request.resource.data.flights is int && request.resource.data.flights >= 0
        && request.resource.data.missions is int && request.resource.data.missions <= 100
        && request.resource.data.mStars is int && request.resource.data.mStars <= 300
        && request.resource.data.badges is list && request.resource.data.badges.size() <= 100
        && request.resource.data.ship is string && request.resource.data.ship.size() <= 20
        && request.resource.data.trail is string && request.resource.data.trail.size() <= 20
        && request.resource.data.theme is string && request.resource.data.theme.size() <= 20
        && request.resource.data.since is string && request.resource.data.since.size() <= 10
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Friend requests: friendReqs/{to}_{from}. Only the two pilots involved can see
    // or remove one (accept, decline, cancel); only the sender can create it.
    match /friendReqs/{id} {
      allow read, delete: if signedIn()
        && (request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
      allow create: if signedIn()
        && !isBanned(request.auth.uid)
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'toName', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.resource.data.to + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/leaderboard/$(request.resource.data.to))
        && request.resource.data.fromName is string
        && get(/databases/$(database)/documents/callsigns/$(request.resource.data.fromName.lower())).data.uid == request.auth.uid
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 16
        && request.resource.data.at == request.time;
    }

    // Friendships: friendships/{a}_{b} with the two user IDs in sorted order.
    // Created only by the pilot accepting a pending request; either friend can remove it.
    match /friendships/{id} {
      allow read, delete: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'at'])
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && id == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.auth.uid in request.resource.data.users
        && exists(/databases/$(database)/documents/friendReqs/$(request.auth.uid + '_' + (request.resource.data.users[0] == request.auth.uid ? request.resource.data.users[1] : request.resource.data.users[0])))
        && request.resource.data.at == request.time;
    }

    // 1v1 duels between friends. Only the two players can see a duel; each can only
    // change the state and their own score. Moves are append-only.
    function inDuel(d) { return signedIn() && (request.auth.uid == d.a || request.auth.uid == d.b); }
    function areFriends(x, y) {
      return exists(/databases/$(database)/documents/friendships/$(x < y ? x + '_' + y : y + '_' + x));
    }
    match /duels/{id} {
      allow read: if signedIn() && (request.auth.uid == resource.data.a || request.auth.uid == resource.data.b);
      allow create: if signedIn()
        && !isBanned(request.auth.uid)
        && request.resource.data.keys().hasOnly(['a', 'b', 'aName', 'bName', 'seed', 'state', 'createdAt',
                                                  'aScore', 'bScore', 'aDone', 'bDone'])
        && request.resource.data.a == request.auth.uid
        && request.resource.data.b is string
        && request.resource.data.b != request.auth.uid
        && areFriends(request.auth.uid, request.resource.data.b)
        && request.resource.data.seed is int
        && request.resource.data.state == 'invited'
        && request.resource.data.aScore == 0 && request.resource.data.bScore == 0
        && request.resource.data.aDone == false && request.resource.data.bDone == false
        && request.resource.data.aName is string && request.resource.data.aName.size() <= 16
        && request.resource.data.bName is string && request.resource.data.bName.size() <= 16
        && request.resource.data.createdAt == request.time;
      allow update: if inDuel(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             request.auth.uid == resource.data.a ? ['state', 'aScore', 'aDone'] : ['state', 'bScore', 'bDone'])
        && request.resource.data.state in ['invited', 'go', 'declined', 'cancelled', 'done']
        && request.resource.data.aScore is int && request.resource.data.bScore is int
        && request.resource.data.aScore <= (request.time.toMillis() - resource.data.createdAt.toMillis()) / 1000 * 2 + 5
        && request.resource.data.bScore <= (request.time.toMillis() - resource.data.createdAt.toMillis()) / 1000 * 2 + 5;
      allow delete: if false;

      match /moves/{m} {
        allow read: if inDuel(get(/databases/$(database)/documents/duels/$(id)).data);
        allow create: if inDuel(get(/databases/$(database)/documents/duels/$(id)).data)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.keys().hasOnly(['by', 'n', 't', 'x', 'y', 'vx', 'vy', 'p', 'px', 'py',
                                                    'a', 'r', 'd', 'w', 'sc', 'c', 'at'])
          && request.resource.data.t in ['S', 'L', 'C', 'V', 'T', 'D']
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    // Ranked 1v1 ratings. Public to read. A pilot changes their own rating only by
    // counting a finished duel they played: the winner gains 12-30 points and the loser
    // loses the same (not below 0), depending on the margin; a draw changes nothing.
    // Worked out from the duel's own scores. Each duel counts once.
    function myDuelScore(d, uid) { return d.a == uid ? d.aScore : d.bScore; }
    function theirDuelScore(d, uid) { return d.a == uid ? d.bScore : d.aScore; }
    // Points for a decided duel: 12 + 18 x margin / max(winner's score, 10), rounded,
    // kept between 12 and 30. The winner gains them, the loser loses them.
    function duelPoints(d) {
      let hi = d.aScore > d.bScore ? d.aScore : d.bScore;
      let lo = d.aScore > d.bScore ? d.bScore : d.aScore;
      let den = hi > 10 ? hi : 10;
      let pts = 12 + math.round(18.0 * (hi - lo) / den);   // 18.0: decimal division, not whole-number
      return pts > 30 ? 30 : (pts < 12 ? 12 : pts);
    }
    function ratingAfter(old, d, uid) {
      return myDuelScore(d, uid) > theirDuelScore(d, uid) ? old + duelPoints(d)
           : myDuelScore(d, uid) < theirDuelScore(d, uid) ? (old >= duelPoints(d) ? old - duelPoints(d) : 0)
           : old;
    }
    function ratingOk(uid, d, o, n) {
      return (d.a == uid || d.b == uid) && d.aDone == true && d.bDone == true
        && n.rating == ratingAfter(o.rating, d, uid)
        && n.wins == o.wins + (myDuelScore(d, uid) > theirDuelScore(d, uid) ? 1 : 0)
        && n.losses == o.losses + (myDuelScore(d, uid) < theirDuelScore(d, uid) ? 1 : 0)
        && n.draws == o.draws + (myDuelScore(d, uid) == theirDuelScore(d, uid) ? 1 : 0)
        && n.duels == o.duels + 1;
    }
    match /ratings/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && !isBanned(uid)
        && request.resource.data.keys().hasOnly(['callsign', 'rating', 'wins', 'losses', 'draws', 'duels', 'lastDuel', 'updatedAt'])
        && request.resource.data.rating == 1000
        && request.resource.data.wins == 0 && request.resource.data.losses == 0
        && request.resource.data.draws == 0 && request.resource.data.duels == 0
        && request.resource.data.lastDuel == ''
        && request.resource.data.callsign is string
        && get(/databases/$(database)/documents/callsigns/$(request.resource.data.callsign.lower())).data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid) && !isBanned(uid)
        && request.resource.data.keys().hasOnly(['callsign', 'rating', 'wins', 'losses', 'draws', 'duels', 'lastDuel', 'updatedAt'])
        && request.resource.data.callsign is string
        && get(/databases/$(database)/documents/callsigns/$(request.resource.data.callsign.lower())).data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && ratingOk(uid, get(/databases/$(database)/documents/duels/$(request.resource.data.lastDuel)).data, resource.data, request.resource.data)
        && !exists(/databases/$(database)/documents/ratings/$(uid)/counted/$(request.resource.data.lastDuel))
        && existsAfter(/databases/$(database)/documents/ratings/$(uid)/counted/$(request.resource.data.lastDuel));
      allow delete: if isOwner(uid) || isAdmin();

      // One marker per duel already counted (with the rating change), so a duel can't count twice.
      match /counted/{did} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['delta', 'at'])
          && request.resource.data.delta is int
          && getAfter(/databases/$(database)/documents/ratings/$(uid)).data.lastDuel == did
          && request.resource.data.delta == getAfter(/databases/$(database)/documents/ratings/$(uid)).data.rating
                                            - get(/databases/$(database)/documents/ratings/$(uid)).data.rating
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    // Admins are added by hand in the Firebase console (a document named after their user ID).
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Banned pilots can't post to the leaderboard. Only admins can ban or unban.
    match /banned/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isAdmin();
    }

    // Anonymous daily play counters (no personal data). Anyone can add exactly 1
    // to one known counter at a time; only admins can read them.
    function statKeys() {
      return ['users', 'newUsers', 'returningUsers', 'd1Returns', 'runs', 'firstRuns',
              'tutorialStarts', 'tutorialDone', 'signups', 'missionStarts', 'missionClears'];
    }
    // A counter either stays the same or goes up by exactly 1.
    function sameOrPlusOne(k) {
      return request.resource.data.get(k, 0) == resource.data.get(k, 0)
          || request.resource.data.get(k, 0) == resource.data.get(k, 0) + 1;
    }
    match /stats/{day} {
      allow read: if isAdmin();
      allow create: if day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && request.resource.data.size() == 1
        && request.resource.data.keys().hasOnly(statKeys())
        && request.resource.data[request.resource.data.keys()[0]] == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(statKeys())
        && sameOrPlusOne('users') && sameOrPlusOne('newUsers') && sameOrPlusOne('returningUsers') && sameOrPlusOne('d1Returns')
        && sameOrPlusOne('runs') && sameOrPlusOne('firstRuns') && sameOrPlusOne('tutorialStarts') && sameOrPlusOne('tutorialDone')
        && sameOrPlusOne('signups') && sameOrPlusOne('missionStarts') && sameOrPlusOne('missionClears');
      allow delete: if false;
    }
  }
}
